---
//@ts-nocheck
import Layout from '../../layouts/Layout.astro';
import { db } from '../../js/backend.mjs';
import Card from '../../components/OffreCard.astro';

// 1. On récupère l'ID depuis l'URL
const { id } = Astro.params;

// 2. On récupère les données de l'agent spécifiquement avec cet ID
// (Cela évite l'erreur si Astro.props est vide)
let agent = null;
try {
    agent = await db.collection('agent').getOne(id);
} catch (error) {
    console.error("Agent non trouvé :", error);
}

// 3. On récupère les offres (maisons) liées à cet agent
// On utilise 'id' directement ici au lieu de 'agent.id' pour plus de sécurité
const offres = await db.collection('maison').getFullList({
    filter: `agent = '${id}'`
});

// 4. On garde getStaticPaths pour la génération statique (TP)
export async function getStaticPaths() {
  const agents = await db.collection('Agent').getFullList();
  return agents.map((agent) => ({
    params: { id: agent.id },
    props: { agent },
  }));
}
---

<Layout title={agent ? `Offres de ${agent.nom}` : "Agent inconnu"}>
  <div class="container mx-auto p-4">
    {agent ? (
      <>
        <h1 class="text-3xl font-bold mb-6 text-indigo-800">
          Les offres de {agent.prenom} {agent.nom}
        </h1>
        
        {offres.length === 0 ? (
          <div class="bg-gray-100 p-6 rounded-lg text-gray-600">
            <p>Cet agent n'a aucune offre pour le moment.</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {offres.map((offre) => (
              <Card offre={offre} />
            ))}
          </div>
        )}
      </>
    ) : (
      <div class="bg-red-50 p-6 rounded-lg text-red-600">
        <p>Erreur : Impossible de charger les données de l'agent.</p>
      </div>
    )}

    <div class="mt-10">
      <a href="/agents" class="text-indigo-600 hover:text-indigo-800 font-medium">
        ← Retour à la liste des agents
      </a>
    </div>
  </div>
</Layout>