---
import '../../styles/global.css'
import Layout from '../../layouts/Layout.astro';
import OffreCard from '../../components/OffreCard.astro';
import { getOffres } from '../../js/backend.mjs';

const offres = await getOffres();
---

<Layout titre="Offres">
    
    <div class="container mx-auto px-4 py-8">

        <div class="flex flex-col md:flex-row justify-between items-center mb-10 gap-4">
            <h1 class="text-4xl font-bold text-gray-800">Nos Offres Immobilières</h1>

            <button id="favori-button" class="group relative inline-flex items-center justify-center overflow-hidden rounded-full p-0.5 font-medium transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:ring-offset-2">
                <span class="relative rounded-full bg-blue-600 px-6 py-2.5 text-white transition-all duration-300 group-hover:bg-blue-700 shadow-md flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                    </svg>
                    <span id="btn-text">Afficher les favoris</span>
                </span>
            </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {offres.map((offre) => (
        <div 
            class="offre border border-gray-200 rounded-xl shadow-sm bg-white overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1" 
            data-favori={offre.Favori}
        >
            <OffreCard offre={offre} />
        </div>
    ))}
</div>
                </div>
            </div>
        </div>
        
        <div id="no-result-message" class="hidden text-center py-12 text-gray-500">
            <p>Aucun favori trouvé.</p>
        </div>

    </div>

    <script>
        const button = document.getElementById('favori-button');
        const btnText = document.getElementById('btn-text');
        const noResultMessage = document.getElementById('no-result-message');
        
        let showOnlyFavorites = false;

        button?.addEventListener('click', () => {
            showOnlyFavorites = !showOnlyFavorites;
            const offresElement = document.querySelectorAll('.offre') as NodeListOf<HTMLElement>;
            let visibleCount = 0;

            offresElement.forEach(offre => {
                const isFavori = offre.dataset.favori === 'true';
                
                // Logique d'affichage
                if (showOnlyFavorites && !isFavori) {
                    offre.style.display = 'none';
                } else {
                    offre.style.display = ''; // Rétablit le display par défaut (block/flex/grid item)
                    // Petite animation de fade-in quand on réaffiche
                    offre.animate([
                        { opacity: 0, transform: 'translateY(10px)' },
                        { opacity: 1, transform: 'translateY(0)' }
                    ], {
                        duration: 300,
                        easing: 'ease-out'
                    });
                    visibleCount++;
                }
            });

            // Gestion du message "Aucun résultat"
            if (noResultMessage) {
                noResultMessage.style.display = (showOnlyFavorites && visibleCount === 0) ? 'block' : 'none';
            }

            // Mise à jour du texte du bouton
            if (btnText) {
                btnText.textContent = showOnlyFavorites 
                    ? 'Afficher tout' 
                    : 'Afficher les favoris';
            }
            
            // Changement visuel du bouton (optionnel : change la couleur)
            const btnSpan = button.querySelector('span.relative');
            if(showOnlyFavorites && btnSpan) {
                btnSpan.classList.remove('bg-blue-600', 'group-hover:bg-blue-700');
                btnSpan.classList.add('bg-slate-700', 'group-hover:bg-slate-800');
            } else if (btnSpan) {
                btnSpan.classList.add('bg-blue-600', 'group-hover:bg-blue-700');
                btnSpan.classList.remove('bg-slate-700', 'group-hover:bg-slate-800');
            }
        });
    </script>

</Layout>
