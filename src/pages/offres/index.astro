---
import '../../styles/global.css'
import Layout from '../../layouts/Layout.astro';
import OffreCard from '../../components/OffreCard.astro';
import { getOffres } from '../../js/backend.mjs';

const offres = await getOffres();
---

<Layout titre="Nos Offres">
    <div class="bg-gray-50 min-h-screen">
        <div class="container mx-auto px-4 py-12">
            
            <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center mb-12 gap-6">
                <div>
                    <h1 class="text-5xl font-extrabold text-slate-900 tracking-tight">Nos Offres <span class="text-indigo-600 italic">Immobilières</span></h1>
                    <p class="text-slate-500 mt-2 text-lg">Trouvez la maison de vos rêves parmi nos sélections exclusives.</p>
                </div>

                <div class="flex flex-wrap gap-3">
                    <a href="/offres/add" class="flex items-center gap-2 px-6 py-3 bg-white border-2 border-green-500 text-green-600 font-bold rounded-2xl hover:bg-green-500 hover:text-white transition-all duration-300 shadow-sm hover:shadow-green-200">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        Ajouter une offre
                    </a>

                    <a href="/agents" class="flex items-center gap-2 px-6 py-3 bg-white border-2 border-indigo-500 text-indigo-600 font-bold rounded-2xl hover:bg-indigo-500 hover:text-white transition-all duration-300 shadow-sm hover:shadow-indigo-200">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
                        </svg>
                        Nos Agents
                    </a>

                    <button id="favori-button" class="flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white font-bold rounded-2xl hover:bg-indigo-700 transition-all duration-300 shadow-lg shadow-indigo-200">
                        <svg id="favori-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
                        </svg>
                        <span id="btn-text">Mes Favoris</span>
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-12">
                <form action="/offres" method="POST" class="lg:col-span-2 flex flex-col sm:flex-row gap-3 bg-white p-3 rounded-3xl shadow-sm border border-slate-100">
                    <div class="flex-1 flex items-center px-4 border-r border-slate-100">
                        <span class="text-slate-400 mr-2 font-bold">$</span>
                        <input type="number" name="minPrix" placeholder="Prix Min" class="w-full outline-none text-slate-700 bg-transparent" />
                    </div>
                    <div class="flex-1 flex items-center px-4">
                        <span class="text-slate-400 mr-2 font-bold">$</span>
                        <input type="number" name="maxPrix" placeholder="Prix Max" class="w-full outline-none text-slate-700 bg-transparent" />
                    </div>
                    <button type="submit" class="bg-slate-900 text-white px-8 py-3 rounded-2xl font-bold hover:bg-slate-800 transition-colors">
                        Filtrer
                    </button>
                </form>

                <a href="/offres/surface/80" class="flex items-center justify-center gap-3 bg-white border border-slate-200 p-3 rounded-3xl font-bold text-slate-600 hover:border-indigo-500 hover:text-indigo-600 transition-all">
                    <span>Maison > 80m²</span>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
                {offres.map((offre) => (
                    <div 
                        class="offre group bg-white rounded-[2rem] overflow-hidden border border-slate-100 shadow-sm hover:shadow-2xl hover:shadow-indigo-100 transition-all duration-500 hover:-translate-y-2" 
                        data-favori={offre.favori ? "true" : "false"}
                    >
                        <OffreCard offre={offre} />
                    </div>
                ))}
            </div>
            
            <div id="no-result-message" class="hidden text-center py-20">
                <div class="inline-block p-6 rounded-full bg-slate-100 mb-4">
                    <svg class="w-12 h-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 9.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-slate-800">Aucun résultat</h3>
                <p class="text-slate-500">Essayez de modifier vos filtres pour voir plus d'offres.</p>
            </div>
        </div>
    </div>

    <script>
        const button = document.getElementById('favori-button');
        const btnText = document.getElementById('btn-text');
        const icon = document.getElementById('favori-icon');
        const noResultMessage = document.getElementById('no-result-message');
        
        let showOnlyFavorites = false;

        button?.addEventListener('click', () => {
            showOnlyFavorites = !showOnlyFavorites;
            const offresElement = document.querySelectorAll('.offre') as NodeListOf<HTMLElement>;
            let visibleCount = 0;

            offresElement.forEach(offre => {
                // Lecture de data-favori (vérifie bien que c'est "true")
                const isFavori = offre.dataset.favori === 'true';
                if (showOnlyFavorites && !isFavori) {
                    offre.style.display = 'none';
                } else {
                    offre.style.display = 'block';
                    visibleCount++;
                }
            });

            if (noResultMessage) {
                noResultMessage.classList.toggle('hidden', visibleCount > 0);
            }

            if (btnText && icon) {
                btnText.textContent = showOnlyFavorites ? 'Voir Tout' : 'Mes Favoris';
                button.classList.toggle('bg-indigo-600', !showOnlyFavorites);
                button.classList.toggle('bg-slate-800', showOnlyFavorites);
            }
        });
    </script>
</Layout>