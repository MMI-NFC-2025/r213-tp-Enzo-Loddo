---
import { getOffresParSurface } from '../../../js/backend.mjs';
import Layout from "../../../layouts/Layout.astro";
import OffreCard from '../../../components/OffreCard.astro'; 

const { surface } = Astro.params;

const offres = await getOffresParSurface(surface);
---

<Layout titre={`Maisons avec une surface > ${surface} m²`}>
    <h1 class="text-3xl font-bold mb-6">Maisons de plus de {surface} m²</h1>

    {offres.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
{offres.map((offre: any) => (
                <OffreCard offre={offre} />
            ))}
        </div>
    ) : (
        <div class="text-center py-10">
            <p class="text-gray-500 text-lg">Aucune offre ne correspond à cette surface.</p>
        </div>
    )}

    <div class="mt-8">
        <a href="/offres" class="text-blue-600 hover:text-blue-800 font-medium">← Retour à toutes les offres</a>
    </div>
</Layout>